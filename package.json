{
  "name": "angular-sofkau",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:es": "ng serve --configuration=es",
    "build": "ng build",
    "build:es": "ng build --configuration=es",
    "build:all": "ng build && ng build --configuration=es",
    "build:prod": "ng build --configuration=production && ng build --configuration=es --base-href /es/",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "i18n:extract": "ng extract-i18n",
    "serve:multi": "concurrently --names \"EN,ES\" --prefix-colors \"blue,green\" \"npm run serve:en\" \"npm run serve:es\"",
    "serve:en": "ng serve --port 4200",
    "serve:es": "ng serve --configuration=es --port 4201",
    "serve:dev": "ng serve --open --port 4200",
    "serve:dev:es": "ng serve --configuration=es --open --port 4201",
    "dev:ssr": "ng run angular-sofkau:serve-ssr",
    "serve:ssr": "node dist/angular-sofkau/server/main.js",
    "build:ssr": "ng build && ng run angular-sofkau:server",
    "prerender": "ng run angular-sofkau:prerender"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^16.2.0",
    "@angular/common": "^16.2.0",
    "@angular/compiler": "^16.2.0",
    "@angular/core": "^16.2.0",
    "@angular/forms": "^16.2.0",
    "@angular/platform-browser": "^16.2.0",
    "@angular/platform-browser-dynamic": "^16.2.0",
    "@angular/platform-server": "^16.2.0",
    "@angular/router": "^16.2.0",
    "@nguniversal/express-engine": "^16.2.0",
    "express": "^4.15.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.13.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.2.16",
    "@angular/cli": "^16.2.16",
    "@angular/compiler-cli": "^16.2.0",
    "@angular/localize": "^16.2.12",
    "@nguniversal/builders": "^16.2.0",
    "@types/express": "^4.17.0",
    "@types/jasmine": "~4.3.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^16.11.7",
    "concurrently": "^9.2.1",
    "jasmine-core": "~4.6.0",
    "jest": "^29.5.0",
    "jest-preset-angular": "^13.1.6",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.1.3"
  }
}
