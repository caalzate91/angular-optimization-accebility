{
  "name": "angular-sofkau",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "dev:ssr": "ng run angular-sofkau:serve-ssr",
    "serve:ssr": "node dist/angular-sofkau/server/main.js",
