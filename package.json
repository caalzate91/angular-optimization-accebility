{
  "name": "angular-sofkau",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:port": "ng serve --configuration=development --port $PORT",
    "build": "ng build --configuration=production",
    "build:locale": "ng build --configuration=$LOCALE",
    "build:i18n": "ng build --localize",
    "serve:i18n": "npm run build:i18n && node serve-i18n.js",
    "build:analyze": "ng build --configuration=production --stats-json && npx webpack-bundle-analyzer dist/angular-sofkau/browser/stats.json",
    "extract-i18n": "ng extract-i18n",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "dev:ssr": "ng run angular-sofkau:serve-ssr",
    "serve:ssr": "node dist/angular-sofkau/server/main.js",
    "build:ssr": "ng build --configuration=production && ng run angular-sofkau:server:production && node dist/angular-sofkau/server/main.js",
    "build:ssr:dev": "ng build && bun run serve:ssr",
    "prerender": "ng run angular-sofkau:prerender"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^16.2.0",
    "@angular/common": "^16.2.0",
    "@angular/compiler": "^16.2.0",
    "@angular/core": "^16.2.0",
    "@angular/forms": "^16.2.0",
    "@angular/platform-browser": "^16.2.0",
    "@angular/platform-browser-dynamic": "^16.2.0",
    "@angular/platform-server": "^16.2.0",
    "@angular/router": "^16.2.0",
    "@angular/service-worker": "^16.2.0",
    "@nguniversal/express-engine": "^16.2.0",
    "compression": "^1.8.1",
    "express": "^4.15.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.13.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^16.2.16",
    "@angular/cli": "^16.2.16",
    "@angular/compiler-cli": "^16.2.0",
    "@angular/localize": "^16.2.12",
    "@nguniversal/builders": "^16.2.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.0",
    "@types/jasmine": "~4.3.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^16.11.7",
    "jasmine-core": "~4.6.0",
    "jest": "^29.5.0",
    "jest-preset-angular": "^13.1.6",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.1.3",
    "webpack-bundle-analyzer": "^4.10.2"
  }
}